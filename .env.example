# GEMINI_API_KEY: required by the Cloud Run server to evaluate boss responses.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: optional for local runs. Cloud Run injects this automatically.
PORT="8080"

# GEMINI_MODEL: optional assertion; guarded evaluations reject any other model.
GEMINI_MODEL="gemini-3-flash-preview"

# VITE_API_PROXY_TARGET: optional local dev proxy target for /api requests.
VITE_API_PROXY_TARGET="http://localhost:8080"

# Public evaluations fail closed until an operator explicitly configures every
# limit and provisions the matching shared ledger. These are not spending approvals.
EVALUATION_ENABLED="false"
EVALUATION_PRICE_VERSION="gemini-3-flash-preview-2026-11-10-v1"
EVALUATION_STORE_PROJECT=""
EVALUATION_STORE_DATABASE="(default)"
EVALUATION_RATE_PER_MINUTE=""
EVALUATION_DAILY_REQUEST_LIMIT=""
EVALUATION_TOTAL_BUDGET_MICRO_USD=""
EVALUATION_MAX_CONCURRENT=""
